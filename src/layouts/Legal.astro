---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<Base title={`${title} · Whitebell`} description={description ?? 'Whitebell 병동 요청 앱의 안내 문서예요.'}>
  <main class="legal">
    <a class="legal-back" href="/">‹ Whitemason</a>
    <h1>{title}</h1>
    {updated && <p class="legal-meta">시행일 {updated}</p>}
    <article class="legal-prose"><slot /></article>
  </main>
  <footer class="legal-foot">
    <nav aria-label="Whitebell 안내">
      <a href="/whitebell/privacy/">개인정보 처리방침</a>
      <span aria-hidden="true">·</span>
      <a href="/whitebell/support/">지원</a>
    </nav>
    <p>Copyright © {new Date().getFullYear()} Whitemason. All rights reserved.</p>
  </footer>
</Base>

<style is:global>
  .legal { max-width: 720px; margin: 0 auto; padding: max(32px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 48px max(16px, env(safe-area-inset-left)); }
  .legal-back { display: inline-block; color: var(--label-2); font-size: 15px; margin-bottom: 16px; }
  .legal h1 { margin: 0 0 4px; font-family: var(--font-display); font-size: 30px; font-weight: 600; line-height: 1.2; }
  .legal-meta { margin: 0 0 24px; color: var(--label-3); font-size: 14px; }
  .legal-prose { font-size: 16px; line-height: 1.7; word-break: keep-all; overflow-wrap: break-word; }
  .legal-prose h2 { margin: 32px 0 8px; font-family: var(--font-display); font-size: 20px; font-weight: 600; line-height: 1.3; }
  .legal-prose h3 { margin: 20px 0 6px; font-size: 17px; font-weight: 600; }
  .legal-prose p, .legal-prose li { margin: 6px 0; }
  .legal-prose ul, .legal-prose ol { padding-left: 22px; }
  .legal-prose a { text-decoration: underline; text-underline-offset: 3px; }
  .legal-prose .muted { color: var(--label-3); font-size: 14px; }
  .legal-prose .note { margin: 16px 0; padding: 12px 14px; border: 1px solid var(--border); border-radius: 14px; font-size: 14px; color: var(--label-2); }
  .legal-prose .wide { overflow-x: auto; }
  .legal-prose table { border-collapse: collapse; width: 100%; font-size: 14px; display: block; overflow-x: auto; }
  .legal-prose th, .legal-prose td { text-align: left; border-bottom: 1px solid var(--border); padding: 8px 8px; vertical-align: top; }
  .legal-prose th { color: var(--label-2); font-weight: 600; white-space: nowrap; }
  .legal-foot { padding: 24px 16px max(32px, env(safe-area-inset-bottom)); color: var(--label-3); font-size: 13px; text-align: center; }
  .legal-foot nav { display: flex; justify-content: center; gap: 4px 8px; flex-wrap: wrap; }
  .legal-foot p { margin: 6px 0 0; }
</style>
