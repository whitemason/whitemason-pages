---
import Base from '../layouts/Base.astro';

const year = new Date().getFullYear();
---

<Base>
  <!-- 첫 페인트 전에 인트로 여부를 정한다. 페이지를 열 때마다 재생하고, 동작 줄이기 설정이면 건너뛴다. -->
  <script is:inline slot="head">
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('intro');
    }
  </script>
  <link slot="head" rel="preload" href="/media/mason.mp4" as="video" type="video/mp4" />

  <main class="home">
    <div class="mark" role="img" aria-label="Whitemason 로고: 망치와 정으로 돌을 다듬는 석공">
      <video
        id="mark"
        src="/media/mason.mp4"
        poster="/media/mason-end.png"
        width="640"
        height="640"
        muted
        playsinline
        preload="none"
        disablepictureinpicture
        disableremoteplayback
        aria-hidden="true"
      ></video>
    </div>

    <h1 class="name reveal" style="--i: 0">Whitemason</h1>

    <section class="apps reveal" style="--i: 1" aria-labelledby="apps-title">
      <h2 id="apps-title" class="sr-only">앱</h2>
      <article class="app">
        <img src="/media/casebook-icon.jpg" width="64" height="64" alt="" />
        <div class="app-text">
          <h3>Casebook</h3>
          <p>숨겨진 사건의 진실</p>
          <p class="platforms">iPhone · iPad · Mac · Apple Vision Pro</p>
          <div class="app-links">
            <a href="https://casebook.whitemason.club">웹사이트 ›</a>
            <a class="pill" href="https://apps.apple.com/kr/app/casebook/id6818760759">App Store</a>
          </div>
        </div>
      </article>
    </section>
  </main>

  <footer class="footer reveal" style="--i: 2">
    <nav aria-label="연락">
      <a href="https://github.com/whitemason">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href="mailto:engineering@whitemason.club">engineering@whitemason.club</a>
    </nav>
    <p>Copyright © {year} Whitemason. All rights reserved.</p>
  </footer>

  <script is:inline>
    (() => {
      const root = document.documentElement;
      if (!root.classList.contains('intro')) return;

      const video = document.getElementById('mark');
      const frame = video.parentElement;
      const skipEvents = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
      let done = false;

      // 영상을 화면 가운데에 크게 띄운다. 끝나면 제자리(로고 위치)로 돌아간다.
      const place = () => {
        const r = frame.getBoundingClientRect();
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        const size = Math.min(vw * 0.78, vh * 0.62, 520);
        const x = vw / 2 - (r.left + r.width / 2);
        const y = vh / 2 - (r.top + r.height / 2);
        video.style.transform = `translate(${x}px, ${y}px) scale(${size / r.width})`;
      };

      const finish = () => {
        if (done) return;
        done = true;
        if (!video.ended) {
          video.pause();
          if (video.readyState > 0 && video.duration) video.currentTime = video.duration;
        }
        video.poster = '/media/mason-end.png';
        root.classList.add('intro-out');
        root.classList.remove('intro');
        video.style.transform = '';
        removeEventListener('resize', place);
        for (const type of skipEvents) removeEventListener(type, finish);
      };

      window.scrollTo(0, 0);
      video.poster = '/media/mason-start.png';
      video.preload = 'auto';
      place();
      addEventListener('resize', place);

      // 아무 입력이나 들어오면 인트로를 건너뛴다.
      for (const type of skipEvents) addEventListener(type, finish, { passive: true });

      video.addEventListener('ended', finish);

      // 백그라운드 탭에서는 브라우저가 영상 재생을 막으므로, 탭이 보일 때 시작한다.
      const start = () => {
        if (document.hidden) return;
        document.removeEventListener('visibilitychange', start);
        // 느린 네트워크나 자동재생 차단에서도 화면이 멈춰 있지 않게 한다.
        const stall = setTimeout(finish, 2500);
        video.addEventListener('playing', () => {
          clearTimeout(stall);
          setTimeout(finish, (video.duration || 4) * 1000 + 1000);
        });
        video.play().catch(finish);
      };
      document.addEventListener('visibilitychange', start);
      start();
    })();
  </script>
</Base>

<style>
  .home {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: max(56px, 9vh) 16px 48px;
    text-align: center;
  }

  .mark {
    width: 220px;
    aspect-ratio: 1;
  }

  /* 영상의 종이는 순백이라 multiply로 겹치면 배경색과 정확히 같아진다. */
  .mark video {
    display: block;
    width: 100%;
    height: 100%;
    mix-blend-mode: multiply;
    transform-origin: center;
    pointer-events: none;
  }

  .name {
    margin: 12px 0 0;
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.003em;
  }

  .apps {
    width: 100%;
    max-width: 440px;
    margin-top: 48px;
  }

  .app {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 18px;
    text-align: left;
  }

  .app img {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: 14px;
    box-shadow: 0 0 0 0.5px var(--separator);
  }

  .app-text {
    min-width: 0;
  }

  .app h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.26;
    letter-spacing: 0.012em;
  }

  .app p {
    margin: 4px 0 0;
    color: var(--label-2);
    font-size: 15px;
    line-height: 1.4;
    letter-spacing: -0.016em;
  }

  .app .platforms {
    color: var(--label-3);
    font-size: 13px;
  }

  .app-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin-top: 14px;
    font-size: 15px;
  }

  .pill {
    padding: 6px 16px;
    background: var(--label);
    border-radius: 980px;
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.43;
  }

  .pill:hover {
    background: #333336;
    text-decoration: none;
  }

  .footer {
    padding: 24px 16px max(32px, env(safe-area-inset-bottom));
    color: var(--label-3);
    font-size: 12px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    text-align: center;
  }

  .footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 8px;
  }

  .footer p {
    margin: 6px 0 0;
  }

  /* 인트로: 로고만 보이고 나머지는 숨긴다. */
  :global(html.intro) body {
    overflow: hidden;
  }

  :global(html.intro) .reveal {
    opacity: 0;
    transform: translateY(12px);
  }

  :global(html.intro-out) .mark video {
    transition: transform 1.1s var(--ease);
  }

  :global(html.intro-out) .reveal {
    transition:
      opacity 0.8s ease,
      transform 0.8s var(--ease);
    transition-delay: calc(0.55s + var(--i) * 0.08s);
  }

  @media (max-width: 734px) {
    .home {
      padding-top: max(40px, 6vh);
    }

    .mark {
      width: 176px;
    }

    .name {
      font-size: 40px;
      line-height: 1.1;
    }

    .apps {
      margin-top: 36px;
    }
  }
</style>
